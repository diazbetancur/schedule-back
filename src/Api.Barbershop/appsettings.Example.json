{
  "App": {
    "Name": "Barbershop API",
    "Version": "0.0.0-placeholder",
    "ApiBasePath": "/api/v1",
    "CorrelationIdHeaderName": "X-Correlation-ID"
  },
  "Database": {
    "ConnectionString": "Host=<db-host>;Port=<db-port>;Database=<db-name>;Username=<db-user>;Password=<db-password>",
    "CommandTimeoutSeconds": 30,
    "AdminDatabase": "<db-admin-database-placeholder>",
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Enabled": true,
    "Issuer": "<jwt-issuer-placeholder>",
    "Audience": "<jwt-audience-placeholder>",
    "SigningKey": "<jwt-signing-key-placeholder>",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "RequireHttpsMetadata": true
  },
  "SeedAdmin": {
    "Enabled": false,
    "Email": "<seed-admin-email-placeholder>",
    "Password": "<seed-admin-password-placeholder>",
    "FullName": "<seed-admin-fullname-placeholder>"
  },
  "Cors": {
    "AllowedOrigins": ["https://<frontend-host-placeholder>"],
    "AllowWildcardOriginInDevelopment": false,
    "AllowCredentials": true
  },
  "Email": {
    "Enabled": false,
    "Provider": "Resend",
    "DefaultFromAddress": "<email-sender-address-placeholder>",
    "DefaultFromName": "<email-sender-name-placeholder>"
  },
  "Resend": {
    "ApiKey": "<resend-api-key-placeholder>",
    "ApiBaseUrl": "https://api.resend.com",
    "SandboxMode": true
  },
  "WebPush": {
    "Enabled": false,
    "PublicKey": "<vapid-public-key-placeholder>",
    "PrivateKey": "<vapid-private-key-placeholder>",
    "ContactEmail": "<support-email-placeholder>"
  },
  "R2Storage": {
    "AccountId": "<r2-account-id-placeholder>",
    "BucketName": "<r2-bucket-placeholder>",
    "AccessKeyId": "<r2-access-key-id-placeholder>",
    "SecretAccessKey": "<r2-secret-access-key-placeholder>",
    "Endpoint": "https://<r2-endpoint-placeholder>",
    "PublicBaseUrl": "https://<r2-public-base-url-placeholder>",
    "Region": "auto"
  },
  "FileStorage": {
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
