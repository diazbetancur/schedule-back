{
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Enabled": true,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "RequireHttpsMetadata": true
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowWildcardOriginInDevelopment": false,
    "AllowCredentials": true
  },
  "Email": {
    "Enabled": false,
    "Provider": "Resend",
    "DefaultFromAddress": "noreply@example.com",
    "DefaultFromName": "Barbershop"
  },
  "Resend": {
    "ApiBaseUrl": "https://api.resend.com",
    "SandboxMode": false
  },
  "WebPush": {
    "Enabled": false,
    "ContactEmail": "support@example.com"
  },
  "R2Storage": {
    "Region": "auto"
  },
  "FileStorage": {
    "MaxUploadBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}