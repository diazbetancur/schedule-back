{
  "App": {
    "FrontendUrl": "https://zona8.app"
  },
  "Database": {
    "CommandTimeoutSeconds": 30,
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Enabled": true,
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 90,
    "RequireHttpsMetadata": true
  },
  "SeedAdmin": {
    "Enabled": false
  },
  "Cors": {
    "AllowedOrigins": ["https://zona-8.vercel.app", "https://zona8.app", "https://www.zona8.app"],
    "AllowWildcardOriginInDevelopment": false,
    "AllowCredentials": true
  },
  "Email": {
    "Enabled": false,
    "Provider": "Resend",
    "DefaultFromAddress": "no-reply@zona8.app",
    "DefaultFromName": "Barbershop"
  },
  "Resend": {
    "ApiBaseUrl": "https://api.resend.com",
    "SandboxMode": false
  },
  "WebPush": {
    "Enabled": true,
    "ContactEmail": "soporte@barbershop.local"
  },
  "R2Storage": {
    "Region": "auto"
  },
  "FileStorage": {
    "MaxUploadBytes": 10485760,
    "AllowedContentTypes": ["image/jpeg", "image/png", "image/webp", "image/gif", "application/pdf"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
