{
  "App": {
    "Name": "Barbershop API",
    "Version": "0.2.0",
    "ApiBasePath": "/api/v1",
    "CorrelationIdHeaderName": "X-Correlation-ID"
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30,
    "AdminDatabase": "",
    "EnableDetailedErrors": false,
    "EnableSensitiveDataLogging": false
  },
  "Jwt": {
    "Enabled": true,
    "Issuer": "",
    "Audience": "",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7,
    "RequireHttpsMetadata": true
  },
  "SeedAdmin": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "FullName": ""
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowWildcardOriginInDevelopment": false,
    "AllowCredentials": true
  },
  "Email": {
    "Enabled": false,
    "Provider": "Resend",
    "DefaultFromAddress": "noreply@example.com",
    "DefaultFromName": "Barbershop"
  },
  "Resend": {
    "ApiKey": "",
    "ApiBaseUrl": "https://api.resend.com",
    "SandboxMode": true
  },
  "R2Storage": {
    "AccountId": "",
    "BucketName": "",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Endpoint": "",
    "PublicBaseUrl": "",
    "Region": "auto"
  },
  "FileStorage": {
    "MaxUploadBytes": 5242880,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
